{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deadlockle",
  "compatibility_date": "2026-04-28",
  "pages_build_output_dir": "./out",

  // D1 database for "request next game" votes. Shared with OWdle so that
  // the leaderboard pools both sites' votes; canonical DB is `owdle-votes`
  // and the `source` column on every row records which site the vote came
  // from. The legacy `deadlockle-votes` D1 (id d65791e3-8d24-4296-825d-
  // a60991328efa) was migrated into this DB and is no longer written to.
  // RAWG_API_KEY is set as a Pages secret (`wrangler pages secret put
  // RAWG_API_KEY`), not in this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "owdle-votes",
      "database_id": "e51eedfa-9f64-4f22-86b2-29b26b413af8"
    }
  ],

  // R2 bucket for rendered OG share cards (functions/og/r/[code].tsx).
  // Free-plan Workers CPU limits kill ~half of COLD wasm renders, so a
  // card renders once (the sharer's prefetch retries until it lands)
  // and every later request — unfurlers, re-scrapes, week-old links —
  // serves the stored PNG without touching the render pipeline. Shared
  // `dailydles` bucket; cards live under the og-cache/deadlockle/
  // prefix, disjoint from both sites' media prefixes.
  "r2_buckets": [
    {
      "binding": "OG_CACHE",
      "bucket_name": "dailydles"
    }
  ]
}
