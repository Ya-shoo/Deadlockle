{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deadlockle",
  "compatibility_date": "2026-04-28",
  "pages_build_output_dir": "./out",

  // D1 database for "request next game" votes. The database_id below is a
  // placeholder — replace with the UUID printed by `wrangler d1 create
  // deadlockle-votes` before the first deploy. RAWG_API_KEY is set as a
  // Pages secret (`wrangler pages secret put RAWG_API_KEY`), not in this
  // file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deadlockle-votes",
      "database_id": "d65791e3-8d24-4296-825d-a60991328efa"
    }
  ]
}
