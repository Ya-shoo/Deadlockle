{
  "name": "deadlockle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,og -c cyan,magenta --kill-others-on-fail \"next dev -p 3001\" \"node scripts/og-dev-server.mjs\"",
    "dev:next": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "build:deploy": "node scripts/build-for-deploy.mjs",
    "deploy:live": "npm run sync-to-r2 && npm run build:deploy && wrangler pages deploy --branch=main && git push",
    "sync-to-r2": "node scripts/sync-to-r2.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "posthog-js": "^1.374.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "ffmpeg-static": "^5.3.0",
    "meyda": "^5.6.3",
    "mime": "^4.1.0",
    "sharp": "^0.32.6",
    "smartcrop-sharp": "^2.0.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
